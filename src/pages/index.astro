---
// The home page: what Honya is, and the way into the guide and the source docs. It's outside
// Starlight so it can look like the app's About screen, but it follows the docs' theme choice.
// Shippori Mincho, served from here rather than Google Fonts.
import "@fontsource/shippori-mincho/800.css"
import { appStoreURL, minimumOS } from "../config"

const site = Astro.site ?? new URL(Astro.url.origin)
const description = "Honya is a manga reader for iPhone and iPad: one place for every series you follow, that remembers where you stopped and keeps up with new chapters."

const features = [
  {
    title: "A library that keeps up",
    body: "Sort into categories, filter by what's unread or downloaded, and see new chapters as they land. Updates run in the background, and can skip series that have ended.",
    href: "/guide/library/",
  },
  {
    title: "A reader that gets out of the way",
    body: "Right to left, left to right or one long scroll. Two pages side by side when there's room, borders cropped, and every setting remembered per title.",
    href: "/guide/reader/",
  },
  {
    title: "Something new each day",
    body: "Discover picks titles from your sources that match the genres you read, and the manga behind this season's anime, ready to open.",
    href: "/guide/discover/",
  },
  {
    title: "Downloads, on every device",
    body: "Download chapters to read offline, and let iCloud carry them to your other devices. Read chapters clear themselves away if you like.",
    href: "/guide/downloads-and-storage/",
  },
  {
    title: "Bring your library with you",
    body: "Restore a Mihon, Tachiyomi or Paperback backup and pick up where you were, progress and categories included. Or import your MyAnimeList list, and keep it current as you read.",
    href: "/guide/backup-and-restore/",
  },
  {
    title: "Share a title",
    body: "Send a link to a manga from its page. It opens in Honya for anyone who has it, and on the site that hosts it for anyone who doesn't.",
    href: "/guide/sharing/",
  },
]
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Honya · Manga reader for iPhone and iPad</title>
<meta name="description" content={description}>
<link rel="canonical" href={new URL("/", site).href}>
<meta property="og:site_name" content="Honya">
<meta property="og:title" content="Honya · Manga reader for iPhone and iPad">
<meta property="og:description" content={description}>
<meta property="og:image" content={new URL("/assets/icon-512.png", site).href}>
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#F4EFE6" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#141B33" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/png" href="/assets/favicon.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="sitemap" href="/sitemap-index.xml">
<script is:inline>
  // The light or dark theme chosen in the docs, which keep it under this key.
  try {
    const theme = localStorage.getItem("starlight-theme")
    if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme
  } catch {}
</script>
</head>
<body>
<div class="backdrop" aria-hidden="true"></div>
<header class="bar">
  <a class="brand" href="/">
    <img src="/assets/apple-touch-icon.png" alt="" width="36" height="36">
    <span>Honya</span>
  </a>
  <nav aria-label="Main">
    <a href="/guide/getting-started/">Guide</a>
    <a href="/sources/how-sources-work/">Sources</a>
    <a href="/developers/quick-start/">Developers</a>
  </nav>
</header>

<main>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Manga reader for iPhone and iPad</p>
      <h1>One place for every series you follow.</h1>
      <p class="lede">Honya remembers where you stopped, keeps up with new chapters, and gets out of the way when it's time to read. Free, with no account to make.</p>
      <div class="actions">
        {appStoreURL ? (
          <a class="badge" href={appStoreURL}>
            <picture>
              <source media="(prefers-color-scheme: dark)" srcset="https://toolbox.marketingtools.apple.com/api/badges/download-on-the-app-store/white/en-us?size=250x83">
              <img src="https://toolbox.marketingtools.apple.com/api/badges/download-on-the-app-store/black/en-us?size=250x83" alt="Download on the App Store" width="163" height="54">
            </picture>
          </a>
        ) : (
          <span class="soon">Coming soon to the App Store</span>
        )}
        <a class="button" href="/guide/getting-started/">Read the guide</a>
      </div>
      <p class="requires">Needs iOS or iPadOS {minimumOS} or later.</p>
    </div>

    <!-- As in the app's Settings → About. -->
    <aside class="definition" aria-label="What Honya means">
      <p class="headword"><span class="kanji" lang="ja">本屋</span> <span class="kana" lang="ja">ほんや</span></p>
      <p class="word"><i>hon·ya</i> <span>noun</span></p>
      <p class="senses">1. a bookshop&ensp; 2. a bookseller</p>
      <p class="parts">
        <span><b lang="ja">本</b> <i>hon</i><span>, book</span></span>
        <span><b lang="ja">屋</b> <i>ya</i><span>, shop</span></span>
      </p>
      <p class="why">We named it after the bookshop round the corner: the shelves you know by heart, a place kept for where you stopped, and something new each time you drop in. The <span lang="ja">書</span> on the icon is the character for books.</p>
    </aside>
  </section>

  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title">Made by readers</h2>
    <ul>
      {features.map((feature) => (
        <li>
          <a href={feature.href}>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="sources" aria-labelledby="sources-title">
    <div>
      <h2 id="sources-title">Honya comes with no sources</h2>
      <p>What you read comes from <strong>sources</strong>: small scripts, each for one website, that other people write and publish in <strong>repositories</strong>. Add a repository's address in Settings and choose the sources you want from it. Honya runs each one in its own sandbox, and they reach the web only through the app.</p>
      <p class="links">
        <a href="/sources/how-sources-work/">How sources work</a>
        <a href="/sources/repositories/">Adding a repository</a>
      </p>
    </div>
    <div class="dev">
      <p class="dev-eyebrow">For developers</p>
      <p>A source is a TypeScript file that exports a handful of async functions. If you've written a Mihon extension, you already know them.</p>
      <pre><code><span class="k">const</span> source: <span class="t">Source</span> = &#123;
  info: &#123; id, name, lang, version, baseUrl &#125;,
  <span class="k">async</span> getPopularManga(page) &#123; … &#125;,
  <span class="k">async</span> searchManga(page, query, filters) &#123; … &#125;,
  <span class="k">async</span> getMangaDetails(manga) &#123; … &#125;,
  <span class="k">async</span> getChapterList(manga) &#123; … &#125;,
  <span class="k">async</span> getPageList(chapter) &#123; … &#125;,
&#125;</code></pre>
      <p class="links"><a href="/developers/quick-start/">Write a source</a></p>
    </div>
  </section>
</main>

<footer>
  <p>Honya is a reader. It doesn't host or publish manga: each title belongs to its creators and is on the site its source reads from.</p>
  <p class="footer-links">
    <a href="/about/privacy/">Privacy</a>
    <a href="/about/support/">Support</a>
    <span>Made by Not in the Box Studio</span>
  </p>
</footer>
</body>
</html>

<style is:global>
  :root {
    --indigo: #24346a;
    --cream: #f4efe6;
    --bg: var(--cream);
    --panel: #ece5d8;
    --ink: #1b2550;
    --muted: #5f5e68;
    --rule: rgba(36, 52, 106, 0.14);
    --outline: rgba(36, 52, 106, 0.3);
    --button-bg: var(--indigo);
    --button-ink: var(--cream);
    --glyph: rgba(36, 52, 106, 0.05);
    --code-bg: #1b2550;
    --code-ink: #e9e5dc;
    --mincho: "Shippori Mincho", "Hiragino Mincho ProN", "Yu Mincho", serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #141b33;
      --panel: #1b2342;
      --ink: var(--cream);
      --muted: #a9aec4;
      --rule: rgba(244, 239, 230, 0.12);
      --outline: rgba(244, 239, 230, 0.3);
      --button-bg: var(--cream);
      --button-ink: var(--indigo);
      --glyph: rgba(244, 239, 230, 0.04);
      --code-bg: #0e1326;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #141b33;
    --panel: #1b2342;
    --ink: var(--cream);
    --muted: #a9aec4;
    --rule: rgba(244, 239, 230, 0.12);
    --outline: rgba(244, 239, 230, 0.3);
    --button-bg: var(--cream);
    --button-ink: var(--indigo);
    --glyph: rgba(244, 239, 230, 0.04);
    --code-bg: #0e1326;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 17px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    position: relative;
  }
  /* The icon's 書, huge and faint behind the hero, in a layer that clips it so the page never
     scrolls sideways. */
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .backdrop::before {
    content: "";
    position: absolute;
    top: -4vmin;
    right: -10vmin;
    width: min(80vmin, 640px);
    aspect-ratio: 384 / 403;
    background: var(--glyph);
    -webkit-mask: url("/assets/glyph.png") center / contain no-repeat;
    mask: url("/assets/glyph.png") center / contain no-repeat;
  }
  a { color: inherit; }
  a:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; border-radius: 6px; }

  .bar, main, footer {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding-left: max(20px, env(safe-area-inset-left));
    padding-right: max(20px, env(safe-area-inset-right));
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: max(20px, env(safe-area-inset-top));
    padding-bottom: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font: 800 22px/1 var(--mincho);
  }
  .brand img {
    border-radius: 9px;
    box-shadow: 0 1px 2px rgba(20, 27, 51, 0.14), 0 4px 12px rgba(20, 27, 51, 0.12);
  }
  .bar nav { display: flex; gap: 22px; }
  .bar nav a {
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
  }
  .bar nav a:hover { color: var(--ink); }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
    padding: 72px 0 88px;
  }
  .eyebrow, .dev-eyebrow {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font: 800 clamp(38px, 6.2vw, 66px)/1.08 var(--mincho);
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .lede {
    max-width: 34em;
    margin: 24px 0 0;
    font-size: 19px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    margin-top: 36px;
  }
  .badge { display: block; border-radius: 10px; }
  .badge img { display: block; height: 54px; width: auto; }
  .soon {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 20px;
    border-radius: 14px;
    font-weight: 600;
    box-shadow: inset 0 0 0 1.5px var(--outline);
  }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 14px;
    background: var(--button-bg);
    color: var(--button-ink);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .button:active, .badge:active { transform: scale(0.98); opacity: 0.85; }
  .requires { margin: 16px 0 0; font-size: 14px; color: var(--muted); }

  .definition {
    padding: 28px 28px 24px;
    border-top: 2px solid var(--ink);
    background: color-mix(in srgb, var(--panel) 70%, transparent);
    border-radius: 0 0 18px 18px;
  }
  .definition p { margin: 0; }
  .headword { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .kanji { font: 800 44px/1 var(--mincho); letter-spacing: 0.02em; }
  .kana { font-size: 15px; color: var(--muted); }
  .word { margin-top: 10px !important; font-size: 17px; }
  .word span { color: var(--muted); }
  .senses { margin-top: 8px !important; }
  .parts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin-top: 14px !important;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
  }
  .parts b { font: 800 22px/1 var(--mincho); margin-right: 4px; }
  .parts span span { color: var(--muted); }
  .why {
    margin-top: 18px !important;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    color: var(--muted);
  }

  h2 {
    margin: 0 0 28px;
    font: 800 clamp(28px, 3.6vw, 38px)/1.15 var(--mincho);
    text-wrap: balance;
  }
  .features { padding: 8px 0 88px; }
  .features ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    border-top: 1px solid var(--rule);
  }
  .features li { border-bottom: 1px solid var(--rule); }
  .features a {
    display: block;
    height: 100%;
    padding: 24px 24px 26px 0;
    text-decoration: none;
  }
  .features h3 {
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 1.3;
  }
  .features h3::after {
    content: " →";
    color: var(--muted);
    transition: margin 0.15s ease;
  }
  .features a:hover h3::after { margin-left: 4px; }
  .features p { margin: 0; font-size: 16px; color: var(--muted); text-wrap: pretty; }

  .sources {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    padding: 56px 0 96px;
    border-top: 2px solid var(--ink);
  }
  .sources p { margin: 0 0 16px; text-wrap: pretty; }
  .sources > div:first-child p { color: var(--muted); }
  .sources strong { color: var(--ink); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 24px !important; }
  .links a { font-weight: 600; text-underline-offset: 4px; text-decoration-thickness: 1.5px; }
  .links a::after { content: " →"; }
  .dev {
    padding: 28px;
    border-radius: 18px;
    background: var(--panel);
  }
  .dev > p:not(.dev-eyebrow):not(.links) { color: var(--muted); }
  pre {
    margin: 20px 0 0;
    padding: 18px 20px;
    overflow-x: auto;
    border-radius: 12px;
    background: var(--code-bg);
    color: var(--code-ink);
    font: 13.5px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  pre .k { color: #f0a58f; }
  pre .t { color: #9fb4f2; }

  footer {
    padding-top: 28px;
    padding-bottom: max(32px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--muted);
  }
  footer p { margin: 0 0 10px; max-width: 46em; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 6px 20px; }

  @media (max-width: 820px) {
    .hero, .sources { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .hero { padding: 40px 0 64px; }
    .features { padding-bottom: 64px; }
    .sources { padding: 44px 0 72px; }
  }
  @media (max-width: 480px) {
    .bar nav { gap: 14px; }
    .bar nav a { font-size: 14px; }
    .brand span { display: none; }
    .lede { font-size: 17px; }
    .features a { padding-right: 0; }
    .definition, .dev { padding: 22px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .button, .features h3::after { transition: none; }
  }
</style>
